# Variables of the stack (docker-compose.yml), for `docker compose` on the VM: copy to .env next to
# docker-compose.yml and fill in what differs from the default; an empty value takes the default. Meaning, defaults
# and examples: docs/deploy.md §4. No secrets belong here: the session key and the accounts are made inside the
# volume prodi-rahasia.

# staging (default: banner + noindex) or produksi
PRODI_MODE=
# official address of the sites, e.g. https://prodi.unsrat.ac.id
PRODI_ALAMAT=
# networks that may open the admin, comma-separated (default: UNSRAT's network)
ADMIN_IP_BOLEH=
# ports on the VM: sites (http) and admin (http)
PORT_SITUS=
PORT_ADMIN=
# load balancer / reverse proxy in front of the stack, comma-separated networks
PROKSI_DEPAN=
# 1 once the admin is opened over HTTPS
ADMIN_HTTPS=
# path of the admin under a shared address, e.g. /admin
ADMIN_AWALAN=
# daily rebuild, HH:MM (default 02:30)
PRODI_BANGUN_HARIAN=
# HTTPS on the VM itself (1), with the certificate in TLS_FOLDER, and its ports
HTTPS_DI_VM=
TLS_FOLDER=
ACME_FOLDER=
PORT_SITUS_HTTPS=
PORT_ADMIN_HTTPS=
# 0 skips the test suites while the image is built (urgent redeploy only)
UJI_SAAT_BUILD=
